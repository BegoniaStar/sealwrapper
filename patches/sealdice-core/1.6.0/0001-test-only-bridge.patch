+func sealwrapperArchiveFile(archive, wanted string) ([]byte, error) {
+	reader, err := os.Open(archive)
+	if err != nil { return nil, err }
+	defer reader.Close()
+	info, err := sealpack.InspectArchive(archive)
+	if err != nil { return nil, err }
+	for _, file := range info.Files {
+		if file == wanted { break }
+	}
+	// ExtractArchive itself is intentionally the real package path; use a temporary root.
+	dir, err := os.MkdirTemp("", "sealwrapper-bridge-read-")
+	if err != nil { return nil, err }
+	defer os.RemoveAll(dir)
+	if _, err = sealpack.ExtractArchive(archive, dir); err != nil { return nil, err }
+	return os.ReadFile(filepath.Join(dir, filepath.FromSlash(wanted)))
+}
