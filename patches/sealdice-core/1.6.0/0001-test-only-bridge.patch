+func sealwrapperCheckArchiveLimits(archive string) error {
+	stat, err := os.Stat(archive)
+	if err != nil { return err }
+	if stat.Size() > 128<<20 { return fmt.Errorf("archive exceeds 128 MiB compressed limit") }
+	reader, err := zip.OpenReader(archive)
+	if err != nil { return err }
+	defer reader.Close()
+	if len(reader.File) > 65535 { return fmt.Errorf("archive exceeds 65535 file limit") }
+	var expanded uint64
+	for _, file := range reader.File {
+		if file.UncompressedSize64 > 0 && file.CompressedSize64 == 0 { return fmt.Errorf("archive entry %s has zero compressed size", file.Name) }
+		if file.CompressedSize64 > 0 && file.UncompressedSize64 > file.CompressedSize64*100 { return fmt.Errorf("archive entry %s exceeds 100:1 compression ratio", file.Name) }
+		expanded += file.UncompressedSize64
+		if expanded > 512<<20 { return fmt.Errorf("archive exceeds 512 MiB expanded limit") }
+	}
+	return nil
+}
