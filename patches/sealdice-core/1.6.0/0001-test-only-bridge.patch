+func sealwrapperCheckReplyConditions(file string, conditions *yaml.Node) []sealwrapperBridgeDiagnostic {
+	if conditions == nil { return nil }
+	if conditions.Kind != yaml.SequenceNode { return []sealwrapperBridgeDiagnostic{sealwrapperDiag("reply.conditions", "error", file, conditions, "conditions must be a YAML sequence")} }
+	diagnostics := []sealwrapperBridgeDiagnostic{}
+	knownMatches := map[string]bool{"matchExact":true, "matchMulti":true, "matchPrefix":true, "matchSuffix":true, "matchRegex":true, "matchFuzzy":true, "matchContains":true, "matchNotContains":true}
+	for _, condition := range conditions.Content {
+		kind := sealwrapperMapValue(condition, "condType")
+		if kind == nil || kind.Kind != yaml.ScalarNode { diagnostics = append(diagnostics, sealwrapperDiag("reply.missing-cond-type", "error", file, condition, "condition requires condType")); continue }
+		switch kind.Value {
+		case "textMatch":
+			match := sealwrapperMapValue(condition, "matchType")
+			if match == nil || !knownMatches[match.Value] { diagnostics = append(diagnostics, sealwrapperDiag("reply.unknown-match-type", "error", file, match, "unsupported matchType")); continue }
+			value := sealwrapperMapValue(condition, "value")
+			if value == nil || value.Kind != yaml.ScalarNode { diagnostics = append(diagnostics, sealwrapperDiag("reply.condition-value", "error", file, value, "textMatch requires string value")) }
+			if match.Value == "matchRegex" && value != nil { if _, err := regexp.Compile(value.Value); err != nil { diagnostics = append(diagnostics, sealwrapperDiag("reply.invalid-regex", "error", file, value, err.Error())) } }
+		case "exprTrue":
+			if value := sealwrapperMapValue(condition, "value"); value == nil || value.Kind != yaml.ScalarNode { diagnostics = append(diagnostics, sealwrapperDiag("reply.condition-value", "error", file, value, "exprTrue requires string value")) }
+		case "textLenLimit":
+			op := sealwrapperMapValue(condition, "matchOp")
+			if op == nil || (op.Value != "ge" && op.Value != "le") { diagnostics = append(diagnostics, sealwrapperDiag("reply.invalid-match-op", "error", file, op, "textLenLimit matchOp must be ge or le")) }
+		default:
+			diagnostics = append(diagnostics, sealwrapperDiag("reply.unknown-cond-type", "error", file, kind, "Unsupported condType: "+kind.Value))
+		}
+	}
+	return diagnostics
+}
+
+func sealwrapperCheckReplyResult(file string, result *yaml.Node) []sealwrapperBridgeDiagnostic {
+	kind := sealwrapperMapValue(result, "resultType")
+	if kind == nil || kind.Kind != yaml.ScalarNode { return []sealwrapperBridgeDiagnostic{sealwrapperDiag("reply.missing-result-type", "error", file, result, "result requires resultType")} }
+	switch kind.Value {
+	case "replyPrivate", "replyGroup", "replyToSender", "runText":
+		if value := sealwrapperMapValue(result, "message"); value == nil { return []sealwrapperBridgeDiagnostic{sealwrapperDiag("reply.result-message", "error", file, result, "result requires message")} }
+		return nil
+	default:
+		return []sealwrapperBridgeDiagnostic{sealwrapperDiag("reply.unknown-result-type", "error", file, kind, "Unsupported resultType: "+kind.Value)}
+	}
+}
