+func sealwrapperDrainEvents(adapter *sealwrapperQQAdapter, offset *int) []sealwrapperQQEvent { adapter.mu.Lock(); defer adapter.mu.Unlock(); events := append([]sealwrapperQQEvent(nil), adapter.events[*offset:]...); *offset = len(adapter.events); return events }
