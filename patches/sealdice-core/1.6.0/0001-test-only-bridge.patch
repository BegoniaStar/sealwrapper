+// Package resources are enumerated by the target in lexical package/file order.
+// Warn about shared names without claiming a tool-defined priority.
+func sealwrapperCrossPackageDiagnostics(archives []string) []sealwrapperBridgeDiagnostic {
+	sort.SliceStable(archives, func(i, j int) bool { left, leftErr := sealpack.InspectArchive(archives[i]); right, rightErr := sealpack.InspectArchive(archives[j]); return leftErr == nil && (rightErr != nil || left.Manifest.Package.ID < right.Manifest.Package.ID) })
+	diagnostics := []sealwrapperBridgeDiagnostic{}
+	helpGroups, templateNames := map[string]string{}, map[string]string{}
+	resourcePaths := map[string]string{}
+	for _, archive := range archives {
+		info, err := sealpack.InspectArchive(archive); if err != nil { continue }
+		for _, file := range info.Files {
+			if strings.HasPrefix(file, "decks/") || strings.HasPrefix(file, "reply/") { kind := strings.SplitN(file, "/", 2)[0]; key := kind+":"+file; if first, exists := resourcePaths[key]; exists && first != info.Manifest.Package.ID { diagnostics = append(diagnostics, sealwrapperDiag(kind+".path-conflict", "warning", file, nil, kind+" path is shared with "+first+"; target core enumerates package IDs and paths lexically, so both are loaded in that observed order")) } else { resourcePaths[key] = info.Manifest.Package.ID } }
+			if strings.HasPrefix(file, "helpdoc/") {
+				parts := strings.Split(strings.TrimPrefix(file, "helpdoc/"), "/")
+				if len(parts) > 1 { group := parts[0]; if first, exists := helpGroups[group]; exists && first != info.Manifest.Package.ID { diagnostics = append(diagnostics, sealwrapperDiag("helpdoc.group-conflict", "warning", file, nil, "helpdoc group "+group+" is shared with "+first+"; target core merges files in package-ID order")) } else { helpGroups[group] = info.Manifest.Package.ID } }
+			}
+			if strings.HasPrefix(file, "templates/") {
+				data, readErr := sealwrapperArchiveFile(archive, file); if readErr != nil { continue }
+				tmpl, parseErr := LoadGameSystemTemplateFromBytes(data, filepath.Ext(file)); if parseErr != nil || tmpl == nil { continue }
+				identifiers := []string{tmpl.Name}
+				for canonical, aliases := range tmpl.Alias { identifiers = append(identifiers, canonical); identifiers = append(identifiers, aliases...) }
+				for _, name := range identifiers { if name == "" { continue }; if first, exists := templateNames[name]; exists && first != info.Manifest.Package.ID { diagnostics = append(diagnostics, sealwrapperDiag("template.name-conflict", "warning", file, nil, "template name or alias "+name+" is shared with "+first+"; target core applies lexical package/file order and later templates overwrite")) } else { templateNames[name] = info.Manifest.Package.ID } }
+			}
+		}
+	}
+	return diagnostics
+}
