+func sealwrapperCheckReply(archive, file string) []sealwrapperBridgeDiagnostic {
+	data, err := sealwrapperArchiveFile(archive, file)
+	if err != nil { return []sealwrapperBridgeDiagnostic{sealwrapperDiag("reply.read", "error", file, nil, err.Error())} }
+	var parsed ReplyConfig
+	if err = yaml.Unmarshal(data, &parsed); err != nil { return []sealwrapperBridgeDiagnostic{sealwrapperDiag("reply.yaml", "error", file, nil, err.Error())} }
+	var document yaml.Node
+	if err = yaml.Unmarshal(data, &document); err != nil || len(document.Content) == 0 { return []sealwrapperBridgeDiagnostic{sealwrapperDiag("reply.yaml", "error", file, nil, "target YAML parser rejected the reply")} }
+	root := document.Content[0]
+	diagnostics := sealwrapperCheckReplyConditions(file, sealwrapperMapValue(root, "conditions"))
+	items := sealwrapperMapValue(root, "items")
+	if items == nil || items.Kind != yaml.SequenceNode { return append(diagnostics, sealwrapperDiag("reply.items", "error", file, root, "items must be a YAML sequence")) }
+	if !parsed.Enable { diagnostics = append(diagnostics, sealwrapperDiag("reply.disabled", "warning", file, root, "reply file is disabled")) }
+	for _, item := range items.Content {
+		diagnostics = append(diagnostics, sealwrapperCheckReplyConditions(file, sealwrapperMapValue(item, "conditions"))...)
+		results := sealwrapperMapValue(item, "results")
+		if results == nil || results.Kind != yaml.SequenceNode { diagnostics = append(diagnostics, sealwrapperDiag("reply.results", "error", file, item, "results must be a YAML sequence")); continue }
+		if len(results.Content) == 0 { diagnostics = append(diagnostics, sealwrapperDiag("reply.empty-results", "warning", file, results, "reply item has no results")) }
+		for _, result := range results.Content { diagnostics = append(diagnostics, sealwrapperCheckReplyResult(file, result)... ) }
+	}
+	return diagnostics
+}
