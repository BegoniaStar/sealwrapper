+func sealwrapperInstallEnableReloadAndScenario(t *testing.T, request sealwrapperBridgeRequest) (map[string]any, map[string]any, error) {
+	t.Helper()
+	t.Chdir(t.TempDir())
+	dice, endpoint, _, cleanup := newExecuteNewTestDice(t)
+	defer cleanup()
+	if err := dice.DBOperator.GetDataDB(constant.WRITE).AutoMigrate(&model.AttributesItemModel{}); err != nil { return nil, nil, err }
+	defer func() {
+		if dice.JsExtRegistry != nil {
+			dice.JsExtRegistry.Range(func(_ string, extension *ExtInfo) bool {
+				if extension != nil && extension.Storage != nil { _ = extension.StorageClose() }
+				return true
+			})
+		}
+		if dice.JsScriptCron != nil { dice.JsScriptCron.Stop() }
+		if dice.ExtLoopManager != nil {
+			if loop := dice.ExtLoopManager.GetWebLoop(); loop != nil { loop.Stop() }
+			dice.ExtLoopManager.SetLoop(nil)
+		}
+	}()
+	adapter := &sealwrapperQQAdapter{}
+	endpoint.Adapter = adapter
+	originalRandom := randSourceDrawAndTmplSelect
+	randSourceDrawAndTmplSelect = rand.New(rand.NewSource(request.Scenario.Seed))
+	defer func() { randSourceDrawAndTmplSelect = originalRandom }()
+	if err := os.MkdirAll(filepath.Join(dice.BaseConfig.DataDir, "decks"), 0o700); err != nil { return nil, nil, err }
+	if err := os.MkdirAll("data/decks", 0o700); err != nil { return nil, nil, err }
+	pm := NewPackageManager(dice)
+	dice.PackageManager = pm
+	if err := pm.Init(); err != nil { return nil, nil, err }
+	temporaryDir := pm.getPackageTempDir()
+	if err := os.MkdirAll(temporaryDir, 0o700); err != nil { return nil, nil, err }
+	archives := append([]string{request.Archive}, request.Archives...)
+	packageResults := make([]map[string]any, 0, len(archives))
+	var err error
+	for index, archive := range archives {
+		stagedArchive := filepath.Join(temporaryDir, fmt.Sprintf("input-%02d.sealpack", index))
+		source, openErr := os.Open(archive); if openErr != nil { return nil, nil, openErr }
+		destination, createErr := os.Create(stagedArchive); if createErr != nil { source.Close(); return nil, nil, createErr }
+		_, copyErr := io.Copy(destination, source); closeSourceErr := source.Close(); closeDestinationErr := destination.Close()
+		if copyErr != nil { return nil, nil, copyErr }; if closeSourceErr != nil { return nil, nil, closeSourceErr }; if closeDestinationErr != nil { return nil, nil, closeDestinationErr }
+		if err = pm.Install(stagedArchive); err != nil { return nil, nil, err }
+		info, inspectErr := sealpack.InspectArchive(stagedArchive); if inspectErr != nil { return nil, nil, inspectErr }
+		enabled, enableErr := pm.Enable(info.Manifest.Package.ID); if enableErr != nil { return nil, nil, enableErr }
+		reloaded, reloadErr := pm.Reload(info.Manifest.Package.ID); if reloadErr != nil { return nil, nil, reloadErr }
+		packageResults = append(packageResults, map[string]any{"id":info.Manifest.Package.ID, "installed":true, "enabled":enabled.Success, "enableReloadNeeded":enabled.ReloadNeeded, "reloaded":reloaded.Success, "reloadedItems":reloaded.ReloadedItems})
+	}
+	install := map[string]any{"installed":len(packageResults) > 0, "enabled":true, "reloaded":true, "packages":packageResults}
+	if request.Operation == "smoke" { return install, nil, nil }
+	if err := sealwrapperConfigureScenarioHost(dice, request.Scenario.Host); err != nil { return nil, nil, err }
+	dice.Config.CustomReplyConfigEnable = true
+	conversation := request.Scenario.Conversation
+	if conversation.Kind == "" { conversation.Kind = "group" }; if conversation.ID == "" { conversation.ID = "QQ-Group:sealwrapper" }; if conversation.Name == "" { conversation.Name = "sealwrapper" }
+	fakeClock := time.Unix(0, 0).UTC()
+	if request.Scenario.Clock != "" { if parsed, parseErr := time.Parse(time.RFC3339, request.Scenario.Clock); parseErr == nil { fakeClock = parsed.UTC() } else { return nil, nil, fmt.Errorf("scenario clock: %w", parseErr) } }
+	previousScenarioTime := fakeClock
+	hasPreviousScenarioTime := false
+	transcriptMessages := []map[string]any{}
+	sequence := 0
+	replySequence := 0
+	for _, item := range request.Scenario.Messages { if item.Sequence > replySequence { replySequence = item.Sequence } }
+	transcriptSequence := 0
+	eventOffset := 0
+	for _, item := range request.Scenario.Messages {
+		sequence++; inputSequence := item.Sequence; if inputSequence > 0 { sequence = inputSequence }
+		scope := item.Scope; if scope == "" { scope = conversation.Kind }
+		nickname := item.Nickname; if nickname == "" { nickname = item.User.Nickname }; if nickname == "" { nickname = "Tester" }
+		role := item.Role; if role == "" { role = item.User.Role }
+		userID := item.QQ; if !strings.HasPrefix(userID, "QQ:") { userID = "QQ:" + userID }
+		timestamp := item.Timestamp; if timestamp == "" { timestamp = fakeClock.Add(time.Duration(sequence-1) * time.Second).Format(time.RFC3339Nano) }
+		currentScenarioTime, parseErr := time.Parse(time.RFC3339, timestamp); if parseErr != nil { return nil, nil, fmt.Errorf("scenario message timestamp: %w", parseErr) }; currentScenarioTime = currentScenarioTime.UTC()
+		if scope == "group" && hasPreviousScenarioTime { if group, ok := dice.ImSession.ServiceAtNew.Load(conversation.ID); ok { group.LastCustomReplyTime = float64(time.Now().Add(-currentScenarioTime.Sub(previousScenarioTime)).UnixMilli()) / 1000 } }
+		if err := sealwrapperApplyScenarioVariables(dice, conversation.ID, userID, request.Scenario.Variables); err != nil { return nil, nil, err }
+		if err := sealwrapperApplyScenarioVariables(dice, conversation.ID, userID, item.User.Variables); err != nil { return nil, nil, err }
+		if err := sealwrapperApplyScenarioVariables(dice, conversation.ID, userID, item.Variables); err != nil { return nil, nil, err }
+		transcriptSequence++; transcriptMessages = append(transcriptMessages, map[string]any{"sequence":sequence, "transcriptSequence":transcriptSequence, "timestamp":timestamp, "direction":"in", "scope":scope, "qq":item.QQ, "nickname":nickname, "role":role, "text":item.Text, "segments":item.Segments, "rawApi":"ExecuteNew"})
+		adapter.mu.Lock(); adapter.activeInputSequence = sequence; adapter.mu.Unlock()
+		if scope == "private" {
+			message := newPrivateMsg(userID, item.Text); message.RawID = sequence; message.Sender.Nickname = nickname; sealwrapperApplyScenarioSender(message, role); message.Segment = sealwrapperScenarioSegments(item.Segments, item.Text); dice.ImSession.ExecuteNew(endpoint, message)
+		} else {
+			message := newGroupMsg(conversation.ID, userID, item.Text); message.RawID = sequence; message.Sender.Nickname = nickname; sealwrapperApplyScenarioSender(message, role); message.Segment = sealwrapperScenarioSegments(item.Segments, item.Text); dice.ImSession.ExecuteNew(endpoint, message)
+		}
+		// ReplyGroup/ReplyPerson call the real core SplitText path before the
+		// adapter, so a formatted #{SPLIT} reply is recorded as multiple events.
+		// Drain after each input so the transcript matches the chat timeline:
+		// user message, all of its bot replies, then the next user message.
+		time.Sleep(100 * time.Millisecond)
+		events := sealwrapperDrainEvents(adapter, &eventOffset)
+		adapter.mu.Lock(); adapter.activeInputSequence = 0; adapter.mu.Unlock()
+		for eventIndex, event := range events { replySequence++; transcriptSequence++; replyTimestamp := currentScenarioTime.Add(time.Duration(eventIndex+1) * time.Millisecond).Format(time.RFC3339Nano); transcriptMessages = append(transcriptMessages, map[string]any{"sequence":replySequence, "transcriptSequence":transcriptSequence, "timestamp":replyTimestamp, "direction":event.Direction, "scope":event.Scope, "qq":"100000", "nickname":"TestBot", "text":event.Text, "rawApi":event.RawAPI, "inReplyToSequence":event.InReplyToSequence}) }
+		previousScenarioTime, hasPreviousScenarioTime = currentScenarioTime, true
+	}
+	sort.SliceStable(transcriptMessages, func(i, j int) bool { return transcriptMessages[i]["transcriptSequence"].(int) < transcriptMessages[j]["transcriptSequence"].(int) })
+	return install, map[string]any{"title":request.Scenario.Title, "conversation":conversation, "messages":transcriptMessages}, nil
+}
