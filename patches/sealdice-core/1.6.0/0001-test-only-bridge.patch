+func sealwrapperMapValue(node *yaml.Node, key string) *yaml.Node {
+	if node == nil || node.Kind != yaml.MappingNode { return nil }
+	for index := 0; index+1 < len(node.Content); index += 2 { if node.Content[index].Value == key { return node.Content[index+1] } }
+	return nil
+}
