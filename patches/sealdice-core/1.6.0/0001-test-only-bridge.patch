+func sealwrapperApplyScenarioVariables(dice *Dice, groupID, userID string, values map[string]interface{}) error {
+	if len(values) == 0 { return nil }
+	var attrs *AttributesItem; var err error
+	for key, value := range values {
+		if strings.HasPrefix(key, "$m") { attrs, err = dice.AttrsManager.LoadById(userID) } else if strings.HasPrefix(key, "$g") { attrs, err = dice.AttrsManager.LoadById(groupID) } else { attrs, err = dice.AttrsManager.LoadByIdDirect(groupID, userID) }; if err != nil { return err }
+		switch typed := value.(type) {
+		case string: attrs.Store(key, ds.NewStrVal(typed))
+		case float64: attrs.Store(key, ds.NewIntVal(ds.IntType(typed)))
+		case bool: if typed { attrs.Store(key, ds.NewIntVal(1)) } else { attrs.Store(key, ds.NewIntVal(0)) }
+		default: return fmt.Errorf("scenario variable %s must be string, number, or boolean", key)
+		}
+	}
+	return nil
+}
+
+// sealwrapperConfigureScenarioHost injects only deterministic, in-memory
+// fake-host state after extensions have registered their real config schema.
+// It neither reads external configuration nor changes production core code.
+func sealwrapperConfigureScenarioHost(dice *Dice, host sealwrapperBridgeHost) error {
+	masters := make([]string, 0, len(host.DiceMasters))
+	seenMasters := map[string]bool{}
+	for _, raw := range host.DiceMasters {
+		master := raw
+		if regexp.MustCompile(`^\d+$`).MatchString(master) { master = "QQ:" + master }
+		if !regexp.MustCompile(`^QQ:\d+$`).MatchString(master) { return fmt.Errorf("scenario host dice master must be a numeric QQ ID: %q", raw) }
+		if !seenMasters[master] { seenMasters[master] = true; masters = append(masters, master) }
+	}
+	sort.Strings(masters)
+	dice.DiceMasters = masters
+	for plugin, values := range host.ExtensionConfigs {
+		if plugin == "" { return fmt.Errorf("scenario host extension config has an empty extension ID") }
+		for key, value := range values {
+			item := dice.ConfigManager.getConfig(plugin, key)
+			if item == nil { return fmt.Errorf("scenario host config %s.%s is not registered by an installed extension", plugin, key) }
+			switch item.Type {
+			case "bool": if _, ok := value.(bool); !ok { return fmt.Errorf("scenario host config %s.%s must be bool", plugin, key) }
+			case "string": if _, ok := value.(string); !ok { return fmt.Errorf("scenario host config %s.%s must be string", plugin, key) }
+			case "int": number, ok := value.(float64); if !ok || number != float64(int64(number)) { return fmt.Errorf("scenario host config %s.%s must be an integer", plugin, key) }; value = int64(number)
+			case "float": if _, ok := value.(float64); !ok { return fmt.Errorf("scenario host config %s.%s must be a number", plugin, key) }
+			default: return fmt.Errorf("scenario host config %s.%s uses unsupported registered type %q", plugin, key, item.Type)
+			}
+			if err := sealwrapperSetScenarioConfig(dice.ConfigManager, plugin, key, value); err != nil { return err }
+		}
+	}
+	return nil
+}
+
+func sealwrapperSetScenarioConfig(manager *ConfigManager, plugin, key string, value interface{}) error {
+	manager.lock.Lock()
+	defer manager.lock.Unlock()
+	registered, found := manager.Plugins[plugin]
+	if !found { return fmt.Errorf("scenario host config %s.%s is not registered by an installed extension", plugin, key) }
+	item, found := registered.Configs[key]
+	if !found { return fmt.Errorf("scenario host config %s.%s is not registered by an installed extension", plugin, key) }
+	item.Value = value
+	registered.Configs[key] = item
+	manager.Plugins[plugin] = registered
+	return nil
+}
+
+func sealwrapperApplyScenarioSender(message *Message, role string) {
+	if role == "owner" || role == "admin" { message.Sender.GroupRole = role }
+	if role == "bot" { message.Sender.IsRobot = true }
+}
+
+func sealwrapperScenarioSegments(raw []map[string]interface{}, fallback string) []message.IMessageElement {
+	if len(raw) == 0 { return []message.IMessageElement{&message.TextElement{Content:fallback}} }
+	elements := make([]message.IMessageElement, 0, len(raw))
+	for _, segment := range raw {
+		kind, _ := segment["type"].(string)
+		switch kind {
+		case "text": content, _ := segment["text"].(string); elements = append(elements, &message.TextElement{Content:content})
+		case "at": target, _ := segment["target"].(string); elements = append(elements, &message.AtElement{Target:target})
+		case "face": elements = append(elements, &message.FaceElement{})
+		case "image": elements = append(elements, &message.ImageElement{})
+		default: elements = append(elements, &message.TextElement{Content:""})
+		}
+	}
+	if len(elements) == 0 { return []message.IMessageElement{&message.TextElement{Content:fallback}} }
+	return elements
+}
