+func sealwrapperCheckHelpdoc(archive, file string) []sealwrapperBridgeDiagnostic {
+	data, err := sealwrapperArchiveFile(archive, file)
+	if err != nil { return []sealwrapperBridgeDiagnostic{sealwrapperDiag("helpdoc.read", "error", file, nil, err.Error())} }
+	switch strings.ToLower(filepath.Ext(file)) {
+	case ".json":
+		var document HelpDocFormat
+		if err = json.Unmarshal(data, &document); err != nil { return []sealwrapperBridgeDiagnostic{sealwrapperDiag("helpdoc.json", "error", file, nil, err.Error())} }
+		if strings.TrimSpace(document.Mod) == "" { return []sealwrapperBridgeDiagnostic{sealwrapperDiag("helpdoc.mod", "error", file, nil, "target core helpdoc format requires mod")} }
+		if len(document.Helpdoc) == 0 { return []sealwrapperBridgeDiagnostic{sealwrapperDiag("helpdoc.empty", "warning", file, nil, "helpdoc contains no entries")} }
+	case ".xlsx":
+		workbook, openErr := excelize.OpenReader(bytes.NewReader(data))
+		if openErr != nil { return []sealwrapperBridgeDiagnostic{sealwrapperDiag("helpdoc.xlsx", "error", file, nil, openErr.Error())} }
+		defer workbook.Close()
+		if len(workbook.GetSheetList()) == 0 { return []sealwrapperBridgeDiagnostic{sealwrapperDiag("helpdoc.xlsx", "error", file, nil, "workbook has no sheets")} }
+		for _, sheet := range workbook.GetSheetList() {
+			rows, rowErr := workbook.GetRows(sheet)
+			if rowErr != nil || len(rows) == 0 { return []sealwrapperBridgeDiagnostic{sealwrapperDiag("helpdoc.xlsx", "error", file, nil, "cannot read helpdoc worksheet")} }
+			if _, headerErr := validateXlsxHeaders(rows[0]); headerErr != nil { return []sealwrapperBridgeDiagnostic{sealwrapperDiag("helpdoc.xlsx-header", "error", file, nil, headerErr.Error())} }
+		}
+	}
+	return nil
+}
